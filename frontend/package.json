{
  "name": "dekopen-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "format:check": "prettier --check . --end-of-line auto",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ux:capture": "node --experimental-strip-types scripts/ux-capture/index.ts",
    "api:generate": "orval --config orval.config.ts",
    "build": "vite build",
    "ux:axe": "node --experimental-strip-types scripts/ux-capture/axe-devui.ts",
    "ux:axe-shell": "node --experimental-strip-types scripts/ux-capture/axe-shell.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.8",
    "posthog-js": "1.422.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "three": "^0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.186.0",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "orval": "8.27.0",
    "otpauth": "9.5.1",
    "prettier": "3.9.6",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
