# ==============================================================================
# DEKOPEN AI GATEWAY & BILLING 2026 — VARIABLES DE ENTORNO OFICIALES
# ==============================================================================

# Core Backend
ENVIRONMENT=development
SECRET_KEY=django-insecure-change-this-in-production-key-seed-dekopen-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.dekopen.com,backend-production.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.dekopen.com

# Supabase Pro (PostgreSQL 16 con RLS + Auth + Storage)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role_key
SUPABASE_JWT_VERIFY_MODE=jwks

# Browser-public Supabase configuration (never place service_role/DB/JWT secrets in VITE_*)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon_key

# Supabase Storage Buckets (Cubiertos 100% por Supabase Pro $10k Credits)
SUPABASE_STORAGE_BUCKET_DOCS=documents
SUPABASE_STORAGE_BUCKET_PLANS=dekopen-blueprints
SUPABASE_STORAGE_BUCKET_CATALOGS=dekopen-catalogs
SUPABASE_STORAGE_BUCKET_BACKUPS=dekopen-backups
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin

# AI Gateway — capabilities route through public.ai_routes; each route names a
# provider (uppercase). Wire each real provider here, else its capability
# fails visibly (ai_provider_unavailable). Protocol auto-detects for
# MIMO/OPENAI/OPENROUTER/DEEPSEEK/QWEN; AI_GATEWAY_{P}_PROTOCOL=openai|http
# overrides. AI_GATEWAY_{P}_TIMEOUT_S bounds the request (default 60, 1-600).
AI_GATEWAY_OPENAI_API_KEY=sk-proj-your-openai-key-here
AI_GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_OPENAI_MODEL=gpt-4o-mini

AI_GATEWAY_MIMO_API_KEY=sk-your-primalabs-key-here
AI_GATEWAY_MIMO_BASE_URL=https://api.primalabs.ai/v1
# Leave MODEL unset — the ai_routes provider_model pin names the wire model.
# Only set it as a deliberate override; a leftover value silently wins over
# the route pin. AI_GATEWAY_MIMO_MODEL=

# MOCK serves only development/test. AI_GATEWAY_MOCK_ENABLED=0 forces it off
# (production); =1 opts in explicitly. Production with MOCK routes and the
# flag off refuses ai_provider_mock_disabled — never fabricates answers.
# AI_GATEWAY_MOCK_ENABLED=

# Payments: Flow.cl (Chile - CLP)
FLOW_API_KEY=flow_sandbox_api_key
FLOW_SECRET_KEY=flow_sandbox_secret_key
FLOW_API_URL=https://sandbox.flow.cl/api
# Explicit merchant timezone and public HTTPS origins; no credentials in browser variables.
FLOW_MERCHANT_TIMEZONE=America/Santiago
BILLING_CALLBACK_ORIGIN=https://api.dekopen.com
BILLING_FRONTEND_ORIGIN=https://app.dekopen.com
# Flow callbacks contain a token; verify through the signed provider status API.

# Production API and encrypted logical backup (server secrets only)
REDIS_URL=redis://localhost:6379/0
# Set RELEASE_SHA from the deployed Git commit, normally RAILWAY_GIT_COMMIT_SHA.
RELEASE_SHA=
BACKUP_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=5
RESTORE_DATABASE_URL=postgresql://postgres:[PASSWORD]@[CLEAN_RESTORE_HOST]:5432/postgres?sslmode=require&connect_timeout=5
# Exactly 64 hex characters generated securely; custody separate from database backups.
BACKUP_ENCRYPTION_KEY=

# Payments: Paddle Global MoR (USD - Taxes/VAT automatizado)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=paddle_sandbox_api_key
PADDLE_WEBHOOK_SECRET=paddle_sandbox_webhook_secret
PADDLE_CLIENT_TOKEN=paddle_sandbox_client_token

# Mailing & Telemetry
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=notificaciones@dekopen.com
CUSTOMERIO_SITE_ID=customerio_site_id
CUSTOMERIO_API_KEY=customerio_api_key

VITE_POSTHOG_KEY=phc_public_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_FIN_INTERCOM_APP_ID=intercom_app_id
JAM_PROJECT_ID=jam_project_token
N8N_WEBHOOK_URL=https://dekopen.app.n8n.cloud/webhook/...
